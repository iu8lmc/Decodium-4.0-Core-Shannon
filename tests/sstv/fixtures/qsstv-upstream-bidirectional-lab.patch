+    auto* timer = new QTimer(&app);
+    auto body = std::make_shared<QByteArray>();
+    auto params = std::make_shared<drmTxParams>();
+    QObject::connect(timer, &QTimer::timeout, &app, [timer, body, params]() {
+      const QString ready = qEnvironmentVariable("QSSTV_BSR_RX_READY");
+      const QString trigger = qEnvironmentVariable("QSSTV_BSR_RX_TRIGGER");
+      const QString output = qEnvironmentVariable("QSSTV_BSR_RX_OUTPUT");
+      if (!QFileInfo(ready).isAbsolute() || !QFileInfo(trigger).isAbsolute() || !QFileInfo(output).isAbsolute()) return;
+      if (!QFile::exists(ready)) {
+        QFile file(ready); if (!file.open(QIODevice::WriteOnly | QIODevice::NewOnly)) return;
+        file.write("ready\n");
+        fprintf(stderr,"LAB live audio input=BlackHole 2ch output=BlackHole 2ch\n");
+      }
+      if (!body->isEmpty()) {
+        if (QFile::exists(qEnvironmentVariable("QSSTV_BSR_RX_SEND"))) {
+          timer->stop(); fprintf(stderr,"LAB single process sending BSR\n");
+          txWidgetPtr->functionsPtr()->sendBSR(body.get(), *params);
+        }
+        return;
+      }
