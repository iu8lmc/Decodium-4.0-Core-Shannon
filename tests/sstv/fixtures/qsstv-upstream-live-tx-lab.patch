+  const QString labRoot = qEnvironmentVariable("DECODIUM_QSSTV_LAB_ROOT");
+  const QFileInfo rootInfo(labRoot);
+  if (labRoot.isEmpty() || !rootInfo.isAbsolute() || !rootInfo.isDir() || rootInfo.isSymLink()
+      || rootInfo.canonicalFilePath().isEmpty()) return 2;
+  QSettings::setDefaultFormat(QSettings::IniFormat);
