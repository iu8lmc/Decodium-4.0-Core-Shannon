+        QFile file(output); if (!file.open(QIODevice::WriteOnly | QIODevice::NewOnly)) return;
+        if (file.write(tb->baBSR) != tb->baBSR.size()) return;
+        fprintf(stderr,"LAB live RX BSR id=%u total=%d received=%u bytes=%lld\n",tb->transportID,tb->totalSegments,tb->segmentsReceived,(long long)tb->baBSR.size());
+        *body = tb->baBSR;
+        params->robMode=tb->robMode; params->interleaver=tb->interLeaver; params->qam=tb->mscMode;
+        params->protection=tb->mpx; params->bandwith=tb->spectrum;
+        return;
+      }
+    });
+    timer->start(250);
+  }
+  const QString labImage = qEnvironmentVariable("DECODIUM_QSSTV_LAB_IMAGE");
+  if (!labImage.isEmpty()) {
