#version 440

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer ParamsBuffer {
    int n;
    int binStart;
    int nBins;
    int waterfallRows;
    int waterfallWriteRow;
    int peakHold;
    int resetPeak;
    int reserved0;
    float inverseNormSquared;
    float powerFloor;
    float binStep;
    float displayMinDb;
    float displayInvRange;
    float peakDecay;
    float reserved1;
    float reserved2;
} params;

layout(std430, binding = 1) buffer SampleBuffer {
    float samples[];
};

layout(std430, binding = 2) buffer DebugOutputBuffer {
    float debugDbValues[];
};

layout(r32f, binding = 3) uniform writeonly image2D spectrumImage;
layout(r32f, binding = 4) uniform writeonly image2D waterfallImage;
layout(r32f, binding = 5) uniform writeonly image2D rowParamsImage;
layout(r32f, binding = 6) uniform image2D peakImage;

const float TWO_PI = 6.28318530717958647692;
const float INV_LOG_10 = 0.4342944819032518;

float blackmanHarris(int i, int n)
{
    float phase = TWO_PI * float(i) / float(max(n - 1, 1));
    return 0.35875
         - 0.48829 * cos(phase)
         + 0.14128 * cos(2.0 * phase)
         - 0.01168 * cos(3.0 * phase);
}

void main()
{
    int outIndex = int(gl_GlobalInvocationID.x);
    if (outIndex >= params.nBins)
        return;

    float bin = float(params.binStart) + float(outIndex) * params.binStep;
    float phaseStep = -TWO_PI * bin / float(params.n);
    float stepRe = cos(phaseStep);
    float stepIm = sin(phaseStep);
    float rotRe = 1.0;
    float rotIm = 0.0;
    float sumRe = 0.0;
    float sumIm = 0.0;

    for (int i = 0; i < params.n; ++i) {
        float pcm = samples[i] * blackmanHarris(i, params.n);
        sumRe += pcm * rotRe;
        sumIm += pcm * rotIm;

        float nextRe = rotRe * stepRe - rotIm * stepIm;
        float nextIm = rotRe * stepIm + rotIm * stepRe;
        rotRe = nextRe;
        rotIm = nextIm;
    }

    float normalizedPower = (sumRe * sumRe + sumIm * sumIm) * params.inverseNormSquared;
    float db = normalizedPower > params.powerFloor
        ? 10.0 * log(normalizedPower) * INV_LOG_10
        : -200.0;

    debugDbValues[outIndex] = db;
    imageStore(spectrumImage, ivec2(outIndex, 0), vec4(db, 0.0, 0.0, 1.0));

    float peakDb = db;
    if (params.peakHold != 0 && params.resetPeak == 0) {
        float previous = imageLoad(peakImage, ivec2(outIndex, 0)).r;
        if (isnan(previous) || previous < -190.0)
            previous = db;
        float decayed = previous * params.peakDecay + params.displayMinDb * (1.0 - params.peakDecay);
        peakDb = max(decayed, db);
    }
    imageStore(peakImage, ivec2(outIndex, 0), vec4(peakDb, 0.0, 0.0, 1.0));

    if (params.waterfallRows > 0) {
        int row = params.waterfallWriteRow % params.waterfallRows;
        imageStore(waterfallImage, ivec2(outIndex, row), vec4(db, 0.0, 0.0, 1.0));
        if (outIndex == 0) {
            imageStore(rowParamsImage, ivec2(0, row), vec4(params.displayMinDb, 0.0, 0.0, 1.0));
            imageStore(rowParamsImage, ivec2(1, row), vec4(params.displayInvRange, 0.0, 0.0, 1.0));
        }
    }
}
