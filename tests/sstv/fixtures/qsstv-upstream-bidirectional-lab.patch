+    const QFileInfo readyInfo(qEnvironmentVariable("DECODIUM_QSSTV_LAB_READY"));
+    if (!imageInfo.isAbsolute() || !imageInfo.isFile() || !readyInfo.isAbsolute()) return 3;
+    auto *timer = new QTimer(&app);
+    QObject::connect(timer, &QTimer::timeout, &app, [timer, labImage, readyInfo]() {
+      if (!readyInfo.exists()) return;
+      timer->stop();
+      QMetaObject::invokeMethod(mainWindowPtr, "slotModeChange", Qt::DirectConnection, Q_ARG(int, int(TRXDRM)));
+      drmTxParams p = drmParams;
+      p.robMode=2; p.bandwith=1; p.qam=1; p.protection=0; p.interleaver=0; p.reedSolomon=0;
+      txWidgetPtr->copyProfile(p);
+      txWidgetPtr->setImage(labImage);
+      txWidgetPtr->slotSize(4000);
+      txWidgetPtr->slotStart();
+      fprintf(stderr, "LAB upstream TX requested\n");
+    });
+    timer->start(250);
+  }
   result=app.exec();
   globalEnd();
   return result;
